{
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "description": "List of issues found in the code review. Empty if none.",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"],
            "description": "Severity of the issue"
          },
          "file": {
            "type": "string",
            "description": "Full file path where the issue is located"
          },
          "line": {
            "type": "number",
            "description": "Line number of the issue"
          },
          "title": {
            "type": "string",
            "description": "Short description of the issue"
          },
          "description": {
            "type": "string",
            "description": "Explanation of the problem and why it matters"
          },
          "suggestion": {
            "type": "string",
            "description": "How to fix the issue"
          }
        },
        "required": ["severity", "file", "line", "title", "description", "suggestion"],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "total_findings": {
          "type": "number",
          "description": "Total number of findings"
        },
        "overall_verdict": {
          "type": "string",
          "description": "Brief overall assessment of the code quality",
          "enum": ["looks good", "minor issues", "needs attention", "serious issues"]
        }
      },
      "required": ["total_findings", "overall_verdict"],
      "additionalProperties": false
    }
  },
  "required": ["findings", "summary"],
  "additionalProperties": false
}
